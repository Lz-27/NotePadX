/* light.qss */

QMainWindow, QWidget#centralWidget, QTabWidget#mainTabs, QTabBar {
    background-color: #F3F4F6;
    color: #1F2937;
}

QTextEdit, #editor {
    background-color: #FFFFFF;
    color: #111827;
    border: none;
    padding: 5px;
    selection-background-color: #BFDBFE;
    selection-color: #1E3A8A;
}

#binaryTerminal {
    background-color: #FFFFFF;
    color: #059669;
    font-family: 'Courier New', monospace;
    font-size: 12pt;
    padding: 10px;
    border-left: 1px solid #E5E7EB;
}

#markdownPreview {
    background-color: #FFFFFF;
    color: #111827;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 11pt;
    padding: 15px;
    border-left: 1px solid #E5E7EB;
}

LineNumberArea {
    background-color: #E5E7EB;
    color: #6B7280;
}

/* Tab Widget Styling */
QTabWidget::pane { 
    border: 0px; 
    border-top: 1px solid #E5E7EB;
}

QTabBar::tab {
    background-color: #E5E7EB;
    color: #4B5563;
    border: 1px solid #D1D5DB;
    border-bottom: none;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #D1D5DB;
    border-bottom: 2px solid #3B82F6;
}

QTabBar::tab:hover:!selected {
    background-color: #D1D5DB;
}

QTabBar::close-button {
    image: url("app/icons/close_light.svg");
    background: transparent;
    padding: 2px;
}

QTabBar::close-button:hover {
    background-color: #D1D5DB;
    border-radius: 4px;
}

/* Toolbars */
QToolBar {
    background-color: #F9FAFB;
    border-bottom: 1px solid #E5E7EB;
    padding: 0px;
    spacing: 2px;
}

QPushButton, QComboBox, QSpinBox {
    background-color: transparent;
    color: #374151;
    border: 1px solid transparent;
    padding: 6px 14px;
    margin: 2px 4px;
    border-radius: 6px;
    font-family: "Segoe UI", "Inter", sans-serif;
    font-size: 11pt;
    min-height: 26px;
}

QPushButton:hover, QComboBox:hover, QSpinBox:hover {
    background-color: #E5E7EB;
}

QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    color: #111827;
    border: 1px solid #E5E7EB;
    selection-background-color: #BFDBFE;
    selection-color: #1E3A8A;
}

QPushButton:checked {
    background-color: #D1D5DB;
    border: 1px solid #9CA3AF;
}

/* Add Tab Button */
QToolButton#addTabBtn {
    background-color: transparent;
    color: #6B7280;
    font-size: 16pt;
    font-weight: bold;
    border-radius: 6px;
    padding: 0px 8px;
    margin-right: 5px;
}
QToolButton#addTabBtn:hover {
    background-color: #E5E7EB;
    color: #111827;
}

/* Theme Toggle Button (Pill/Oval shape) */
QPushButton#themeToggle {
    background-color: #E5E7EB;
    color: #1F2937;
    border: 1px solid #D1D5DB;
    border-radius: 14px;
    padding: 4px 16px;
    font-weight: bold;
    margin: 2px;
    min-height: 26px;
    min-width: 70px;
}
QPushButton#themeToggle:hover {
    background-color: #D1D5DB;
}

/* Find/Replace Bar */
QLineEdit {
    padding: 4px 8px;
    border: 1px solid #D1D5DB;
    border-radius: 4px;
    background: #FFFFFF;
}

/* Menus */
QMenuBar {
    background-color: #F3F4F6;
    color: #374151;
    font-size: 10pt;
    padding: 2px 0px;
    border-bottom: 1px solid #E5E7EB;
}

QMenuBar::item {
    padding: 6px 12px;
    margin: 0px 4px;
    background: transparent;
    border-radius: 6px;
}

QMenuBar::item:selected {
    background-color: #E5E7EB;
}

QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E5E7EB;
    padding: 2px 0px;
    margin: 0px;
}

QMenu::item {
    padding: 2px 20px 2px 20px;
}

QMenu::item:selected {
    background-color: #F3F4F6;
}

QStatusBar {
    background-color: #F3F4F6;
    color: #6B7280;
    font-size: 9pt;
}
