/* ==========================================================================
   NotepadX - Modern Dark Theme (Charcoal / Dark Neutral)
   Palette:
     Bg Main/Bars: #1E1E1E (RGB 30, 30, 30)
     Bg Editor/Panels: #2D2D2D (RGB 45, 45, 45)
     Borders/Separators: #383838 / #333333
     Controls: #2D2D2D
     Text Primary: #FFFFFF / #F0F0F0
     Text Muted: #888888 / #9E9E9E
     Binary Accent (Active): #E06C54
   ========================================================================== */

QMainWindow, QWidget#centralWidget {
    background-color: #1E1E1E;
    color: #F0F0F0;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
}

/* --- Editor & Paneles de Contenido --- */
QTextEdit, #editor {
    background-color: #2D2D2D;
    color: #F0F0F0;
    border: none;
    padding: 6px 10px;
    selection-background-color: #264F78;
    selection-color: #FFFFFF;
    font-family: "Segoe UI", -apple-system, sans-serif;
    font-size: 11pt;
}

#binaryTerminal {
    background-color: #2D2D2D;
    color: #FFFFFF;
    font-family: 'Consolas', 'Cascadia Code', 'Courier New', monospace;
    font-size: 11pt;
    padding: 10px;
    border: none;
    border-left: 1px solid #383838;
}

#markdownPreview {
    background-color: #2D2D2D;
    color: #F0F0F0;
    font-family: "Segoe UI", -apple-system, sans-serif;
    font-size: 11pt;
    padding: 16px;
    border: none;
    border-left: 1px solid #383838;
}

/* Área de números de línea */
LineNumberArea {
    background-color: #1E1E1E;
    color: #757575;
    border-right: 1px solid #2D2D2D;
}

/* Splitter divisorio */
QSplitter::handle {
    background-color: #383838;
    width: 2px;
}
QSplitter::handle:hover {
    background-color: #E06C54;
}

/* --- Sistema de Pestañas --- */
QTabWidget#mainTabs {
    background-color: #1E1E1E;
    border: none;
}

QTabWidget::pane { 
    border: none;
    border-top: 1px solid #333333;
    background-color: #2D2D2D;
}

QTabBar {
    background-color: #1E1E1E;
    qproperty-drawBase: 0;
    border-bottom: 1px solid #333333;
}

QTabBar::tab {
    background-color: #1E1E1E;
    color: #9E9E9E;
    border: 1px solid #333333;
    border-bottom: none;
    padding: 7px 16px;
    margin-top: 3px;
    margin-right: 2px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-size: 9.5pt;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border: 1px solid #3A3A3A;
    border-bottom: 1px solid #2D2D2D;
}

QTabBar::tab:hover:!selected {
    background-color: #282828;
    color: #D4D4D4;
}

QTabBar::close-button {
    image: url("app/icons/close_dark.svg");
    background: transparent;
    border-radius: 4px;
    padding: 2px;
    margin-left: 4px;
}

QTabBar::close-button:hover {
    background-color: #383838;
}

/* Botón de Añadir Pestaña (+) */
QToolButton#addTabBtn {
    background-color: transparent;
    color: #888888;
    font-size: 15pt;
    font-weight: normal;
    border-radius: 6px;
    padding: 1px 8px;
    margin-right: 5px;
}

QToolButton#addTabBtn:hover {
    background-color: #333333;
    color: #FFFFFF;
}

/* --- Barra de Menú y Menús Desplegables --- */
QMenuBar {
    background-color: #1E1E1E;
    color: #CCCCCC;
    font-size: 9.5pt;
    padding: 3px 6px;
    border-bottom: 1px solid #2D2D2D;
}

QMenuBar::item {
    padding: 5px 10px;
    background: transparent;
    border-radius: 4px;
    margin: 1px 2px;
}

QMenuBar::item:selected {
    background-color: #333333;
    color: #FFFFFF;
}

QMenu {
    background-color: #252526;
    color: #CCCCCC;
    border: 1px solid #383838;
    border-radius: 6px;
    padding: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 12px;
    border-radius: 4px;
    margin: 1px 0px;
}

QMenu::item:selected {
    background-color: #333333;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #383838;
    margin: 4px 6px;
}

/* --- Barra de Herramientas Principal (Toolbar) --- */
QToolBar {
    background-color: #1E1E1E;
    border-bottom: 1px solid #333333;
    padding: 3px 6px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #333333;
    margin: 4px 4px;
}

/* Botones de acción, formato y toggles */
QPushButton, QComboBox, QSpinBox {
    background-color: #2D2D2D;
    color: #D4D4D4;
    border: 1px solid #3A3A3A;
    padding: 5px 12px;
    margin: 2px 3px;
    border-radius: 6px;
    font-size: 9.5pt;
    min-height: 24px;
}

QPushButton:hover, QComboBox:hover, QSpinBox:hover {
    background-color: #383838;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #444444;
}

/* Estados Activos/Checked (Negrita, Cursiva, etc.) */
QPushButton:checked {
    background-color: #3E3E3E;
    border: 1px solid #666666;
    color: #FFFFFF;
}

/* Botón Binario Activo (Color salmón/coral) */
QPushButton#btnToggleBinary:checked {
    background-color: #E06C54;
    border: 1px solid #E06C54;
    color: #FFFFFF;
}

QPushButton#btnToggleBinary:checked:hover {
    background-color: #EB7963;
}

/* Desplegables ComboBox y SpinBox */
QComboBox {
    background-color: #2D2D2D;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 20px;
}

QComboBox::drop-down {
    border: none;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
}

QComboBox::down-arrow {
    image: url("app/icons/chevron_down_dark.svg");
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #252526;
    color: #F0F0F0;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #383838;
    selection-color: #FFFFFF;
}

QSpinBox {
    background-color: #2D2D2D;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 2px 6px;
}

/* Botón Conmutador de Tema (Pill Switch en Barra de Menú) */
QPushButton#themeToggle {
    background-color: #1E1E1E;
    color: #D4D4D4;
    border: 1px solid #3A3A3A;
    border-radius: 14px;
    padding: 4px 14px;
    font-size: 9.5pt;
    margin: 2px 6px;
    min-height: 24px;
}

QPushButton#themeToggle:hover {
    background-color: #2D2D2D;
    color: #FFFFFF;
    border-color: #555555;
}

/* Barra de Búsqueda y Reemplazo */
QWidget#findBarWidget {
    background-color: #252526;
    border-bottom: 1px solid #383838;
}

QLineEdit {
    padding: 5px 10px;
    border: 1px solid #3A3A3A;
    border-radius: 5px;
    background: #252526;
    color: #F0F0F0;
    selection-background-color: #264F78;
}

QLineEdit:focus {
    border: 1px solid #555555;
}

/* Barra de Estado (Status Bar) */
QStatusBar {
    background-color: #1E1E1E;
    color: #888888;
    font-size: 9pt;
    border-top: 1px solid #2D2D2D;
    padding: 2px 8px;
}

QStatusBar::item {
    border: none;
}

QStatusBar QLabel {
    color: #888888;
    padding: 0 8px;
}

QPushButton#btnInfo {
    background-color: transparent;
    color: #888888;
    border: none;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 9pt;
}

QPushButton#btnInfo:hover {
    background-color: #2D2D2D;
    color: #FFFFFF;
}

/* Barras de Desplazamiento (Scrollbars) */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #3E3E3E;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #555555;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
}
