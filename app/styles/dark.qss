/* ==========================================================================
   NotepadX - Modern Dark Theme (Operate Mode / Fluent Craft)
   Palette:
     Bg Base: #0F172A (Slate 900)
     Surface/Elevated: #1E293B (Slate 800)
     Border Subtle: #334155 (Slate 700)
     Text Primary: #F8FAFC (Slate 50)
     Text Secondary: #94A3B8 (Slate 400)
     Accent: #38BDF8 (Sky 400) / #0284C7 (Sky 600)
     Selection: #1E3A8A (Blue 900 / 0.5)
   ========================================================================== */

QMainWindow, QWidget#centralWidget {
    background-color: #0F172A;
    color: #F8FAFC;
    font-family: "Segoe UI", -apple-system, BlinkMacSystemFont, "Inter", sans-serif;
}

/* --- Editor & Paneles de Contenido --- */
QTextEdit, #editor {
    background-color: #0F172A;
    color: #F8FAFC;
    border: none;
    padding: 8px 12px;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
    font-family: "Segoe UI", -apple-system, sans-serif;
    font-size: 11pt;
}

#binaryTerminal {
    background-color: #090D16;
    color: #34D399;
    font-family: 'Cascadia Code', 'Consolas', 'Courier New', monospace;
    font-size: 11pt;
    padding: 12px;
    border: none;
    border-left: 1px solid #1E293B;
}

#markdownPreview {
    background-color: #111827;
    color: #F1F5F9;
    font-family: "Segoe UI", -apple-system, sans-serif;
    font-size: 11pt;
    padding: 18px;
    border: none;
    border-left: 1px solid #1E293B;
}

/* Área de números de línea */
LineNumberArea {
    background-color: #0F172A;
    color: #475569;
    border-right: 1px solid #1E293B;
}

/* Splitter divisorio */
QSplitter::handle {
    background-color: #1E293B;
    width: 2px;
}
QSplitter::handle:hover {
    background-color: #38BDF8;
}

/* --- Sistema de Pestañas (Fluent Windows 11 Tabs) --- */
QTabWidget#mainTabs {
    background-color: #0B0F19;
    border: none;
}

QTabWidget::pane { 
    border: none;
    background-color: #0F172A;
}

QTabBar {
    background-color: #0B0F19;
    qproperty-drawBase: 0;
    border-bottom: 1px solid #1E293B;
}

QTabBar::tab {
    background-color: transparent;
    color: #94A3B8;
    border: 1px solid transparent;
    border-bottom: none;
    padding: 7px 16px;
    margin-top: 4px;
    margin-right: 2px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    font-size: 9.5pt;
    font-weight: 500;
}

QTabBar::tab:selected {
    background-color: #0F172A;
    color: #F8FAFC;
    border: 1px solid #1E293B;
    border-bottom: 2px solid #38BDF8;
}

QTabBar::tab:hover:!selected {
    background-color: #1E293B;
    color: #E2E8F0;
}

QTabBar::close-button {
    image: url("app/icons/close_dark.svg");
    background: transparent;
    border-radius: 4px;
    padding: 2px;
    margin-left: 6px;
}

QTabBar::close-button:hover {
    background-color: #334155;
}

/* Botón de Añadir Pestaña (+) */
QToolButton#addTabBtn {
    background-color: transparent;
    color: #94A3B8;
    font-size: 14pt;
    font-weight: normal;
    border-radius: 6px;
    padding: 2px 8px;
    margin: 4px 6px;
}

QToolButton#addTabBtn:hover {
    background-color: #1E293B;
    color: #38BDF8;
}

/* --- Barra de Menú y Menús Desplegables --- */
QMenuBar {
    background-color: #0B0F19;
    color: #CBD5E1;
    font-size: 9.5pt;
    padding: 3px 6px;
    border-bottom: 1px solid #1E293B;
}

QMenuBar::item {
    padding: 5px 10px;
    background: transparent;
    border-radius: 5px;
    margin: 1px 2px;
}

QMenuBar::item:selected {
    background-color: #1E293B;
    color: #F8FAFC;
}

QMenu {
    background-color: #1E293B;
    color: #F1F5F9;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item {
    padding: 6px 28px 6px 12px;
    border-radius: 5px;
    margin: 1px 0px;
}

QMenu::item:selected {
    background-color: #0284C7;
    color: #FFFFFF;
}

QMenu::separator {
    height: 1px;
    background-color: #334155;
    margin: 4px 6px;
}

/* --- Barra de Herramientas Principal (Toolbar) --- */
QToolBar {
    background-color: #0F172A;
    border-bottom: 1px solid #1E293B;
    padding: 3px 6px;
    spacing: 4px;
}

QToolBar::separator {
    width: 1px;
    background-color: #1E293B;
    margin: 4px 4px;
}

/* Botones de acción, formato y toggles */
QPushButton, QComboBox, QSpinBox {
    background-color: transparent;
    color: #CBD5E1;
    border: 1px solid transparent;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 9.5pt;
    min-height: 24px;
}

QPushButton:hover, QComboBox:hover, QSpinBox:hover {
    background-color: #1E293B;
    color: #F8FAFC;
}

QPushButton:pressed {
    background-color: #334155;
}

/* Estados Activos/Checked (Negrita, Cursiva, Binario, etc.) */
QPushButton:checked {
    background-color: #1E293B;
    color: #38BDF8;
    border: 1px solid #38BDF8;
    font-weight: 600;
}

/* Desplegables ComboBox y SpinBox */
QComboBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 6px;
    padding-left: 8px;
    padding-right: 20px;
}

QComboBox::drop-down {
    border: none;
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
}

QComboBox::down-arrow {
    image: url("app/icons/chevron_down_dark.svg");
    width: 10px;
    height: 10px;
}

QComboBox QAbstractItemView {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 4px;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
}

QSpinBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 2px 6px;
}

/* Botón Conmutador de Tema (Pill Switch en Barra de Menú) */
QPushButton#themeToggle {
    background-color: #1E293B;
    color: #F8FAFC;
    border: 1px solid #334155;
    border-radius: 13px;
    padding: 3px 14px;
    font-size: 9pt;
    font-weight: 600;
    margin: 2px 6px;
    min-height: 24px;
}

QPushButton#themeToggle:hover {
    background-color: #334155;
    border-color: #475569;
}

/* Barra de Búsqueda y Reemplazo */
QWidget#findBarWidget {
    background-color: #1E293B;
    border-bottom: 1px solid #334155;
}

QLineEdit {
    padding: 5px 10px;
    border: 1px solid #334155;
    border-radius: 6px;
    background: #0F172A;
    color: #F8FAFC;
    selection-background-color: #0284C7;
}

QLineEdit:focus {
    border: 1px solid #38BDF8;
}

/* Barra de Estado (Status Bar) */
QStatusBar {
    background-color: #0B0F19;
    color: #94A3B8;
    font-size: 9pt;
    border-top: 1px solid #1E293B;
    padding: 2px 8px;
}

QStatusBar QLabel {
    color: #94A3B8;
    padding: 0 8px;
}

QPushButton#btnInfo {
    background-color: transparent;
    color: #94A3B8;
    border: none;
    padding: 2px 8px;
    border-radius: 4px;
    font-size: 9pt;
}

QPushButton#btnInfo:hover {
    background-color: #1E293B;
    color: #38BDF8;
}

/* Barras de Desplazamiento (Scrollbars modernas) */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QScrollBar::handle:vertical {
    background: #334155;
    min-height: 24px;
    border-radius: 4px;
}
QScrollBar::handle:vertical:hover {
    background: #475569;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: none;
    border: none;
}
